{
  "$schema": "https://opencode.ai/v2/cli.json",
  "theme": {
    "name": "system"
  },
  "diffs": {
    "wrap": "word",
    "view": "auto",
    "tree": true,
    "single": false
  },
  "session": {
    "sidebar": "auto",
    "scrollbar": true,
    "thinking": "hide",
    "markdown": "rendered",
    "grouping": "none",
    "verbosity": "high",
    "image_preview": false,
    "new_location": "launch",
    "permissions": "autoaccept"
  },
  "animations": true,
  "terminal": {
    "copy": "select"
  },
  "tabs": {
    "mode": "on",
    "scope": "cwd",
    "layout": "vertical",
    "indicators": "status"
  },
  "prompt": {
    "image_preview": true
  }
}
