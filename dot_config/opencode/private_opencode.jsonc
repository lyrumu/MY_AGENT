{
// @keychain {"env": "OPENCODE_MODEL_KEY_DEEPSEEK", "service": "deepseek", "account": "lyrumu", "reader": "security"}
// @keychain {"env": "OPENCODE_MODEL_KEY_ZAI", "service": "zai", "account": "lyrumu", "reader": "security"}
// @keychain {"env": "OPENCODE_MODEL_KEY_XIAOMI", "service": "xiaomi", "account": "lyrumu", "reader": "security"}
// @keychain {"env": "CONTEXT7_API_KEY", "service": "context7-api-key", "account": "lyrumu", "reader": "security"}
// @keychain {"env": "TAVILY_API_KEY", "service": "tavily-api-key", "account": "lyrumu", "reader": "security"}

  "$schema": "https://opencode.ai/config.json",//作用：为VScode等编辑工具提供自动补全和校验等 不影响opencode实际使用功能
  "autoupdate": true,
  "small_model": "deepseek/deepseek-flash",
  "default_agent": "plan",
  "permission": {
    "read": {
      "*":"allow",
      ".env":"deny",
      ".env/**":"deny",
      "/.env/api_keys.txt":"deny",
      ".env/keys.txt":"deny",
      ".env.example":"allow",
      "*.pem":"deny",
      "*.key":"deny",
      "keys/**":"deny"
    },
    "external_directory":"ask",
    "bash": {
      "*": "ask",
      "ls *": "allow",
      "wc *": "allow",
      "pwd": "allow",
      "echo *": "allow",
      "which *": "allow",
      "git status *": "allow",
      "git diff *": "allow",
      "git log *": "allow",
      "git show *": "allow",
      "git branch *": "allow",
      "npm test": "allow",
      "npm run lint": "allow",
      "npm run build": "allow",
      "pytest *": "allow",
      "go test *": "allow",
      "cargo test *": "allow",
      "rm -rf *": "deny",
      "rm -fr *": "deny",
      "sudo *": "deny",
      "curl * | *": "deny",
      "wget * | *": "deny"
    }
  },
  "plugin": [
    "@dietrichgebert/ponytail"
  ],
  "compaction": {
    "auto": true,
    "prune": true,
    "reserved": 10000
  },
  "watcher": {
    "ignore": ["node_modules/**", ".git/**", "dist/**", "build/**", "*.log", ".env/**", "keys/**"]
  },
  "lsp": true,
  "formatter": true,
  "shell": "zsh",
  "agent": {
    "build": {
      "permission": {
        "bash": {
          "*": "ask",
          "git status *": "allow",
          "git diff *": "allow",
          "git log *": "allow",
          "git show *": "allow",
          "git branch *": "allow",
          "git push *": "deny",
          "git reset --hard *": "deny"
        }
      }
    }
  },
  "mcp": {
    "playwright": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@playwright/mcp"
      ],
      "enabled": true,
      "environment": {
        "PLAYWRIGHT_MCP_HEADLESS": "true"
      }
    },
    "context7": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@upstash/context7-mcp"
      ],
      "enabled": true,
      "environment": {
        "CONTEXT7_API_KEY": "{env:CONTEXT7_API_KEY}"
      }
    },
    "tavily": {
      "type": "local",
      "command": ["tavily-mcp"],//这里采用了本地安装tavily 后续需要手动管理更新
      "enabled": true,
      "environment": {
        "TAVILY_API_KEY": "{env:TAVILY_API_KEY}"
      }
    }
  },
  "provider": {
  "deepseek": {
    "options": {
      "apiKey": "{env:OPENCODE_MODEL_KEY_DEEPSEEK}"
    }
  },
  "zai-coding-plan": {
    "options": {
      "apiKey": "{env:OPENCODE_MODEL_KEY_ZAI}",
      "baseURL": "https://api.z.ai/api/coding/paas/v4"
    }
  },
  "xiaomi": {
    "options": {
      "apiKey": "{env:OPENCODE_MODEL_KEY_XIAOMI}"
    }
  }
}
}