export PATH="$HOME/.opencode/bin:$PATH"

#常用别名
alias ll='ls -lah'

#快捷设置关闭临时代理
proxyon() {
    export http_proxy=http://127.0.0.1:7897
    export https_proxy=http://127.0.0.1:7897
    export all_proxy=socks5://127.0.0.1:7897
    echo "Proxy enabled"
}
proxyoff() {
    unset http_proxy
    unset https_proxy
    unset all_proxy
    echo "Proxy disabled"
}
# End of proxy functions

